# Write lock file using Compile classpath (guava is Runtime-only, so excluded)
> kagiDependencyLockWrite
> kagiDependencyLockCheck

# Verify guava is NOT in the lock file (it's Runtime-only, we locked Compile)
$ must-mirror dependency-lock/root.lock.txt test-lock-files/without-guava.lock.txt

# Now switch to Runtime classpath and verify the lock is out of sync
> set kagiDependencyLockClasspath := Runtime
-> kagiDependencyLockCheck

# Write the lock file and check that guava is there
> kagiDependencyLockWrite
$ must-mirror dependency-lock/root.lock.txt test-lock-files/with-guava.lock.txt
> kagiDependencyLockCheck
